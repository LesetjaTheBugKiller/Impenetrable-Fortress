# Set once. Use the same timezone and the same weekend hours on the VPS and on the home PC.

TIMEZONE=Europe/Berlin
OPEN_DAY=Friday
OPEN_TIME=22:00
CLOSE_DAY=Sunday
CLOSE_TIME=22:00

# Home PC only. The keeper ignores these.
VPS_HOST=
RDP_PORT=3389
# On the VPS the keeper also reads RDP_PORT: it locks that port as well as 3389 and the listener port.
# Ports below 1024 (other than 3389) and 135, 139, 445, 5985, 5986, 8080 are refused.
# Set RDP_PORT_FORCE=1 only if one of them really is the Remote Desktop port.
RDP_PORT_FORCE=
RDP_TIMEOUT_SECONDS=5
GMAIL_ADDRESS=
PROVIDER_FROM=
PROVIDER_LINK_HOST=
# Leave SEAL_PATH empty to use %LOCALAPPDATA%\WeekendDesk\seal.json of the account that runs link.
# An absolute path, or one with %LOCALAPPDATA% in it, also works. `install` pins the resolved path
# into the reseal task. That folder must not be OneDrive, Dropbox, Google Drive, or iCloud.
SEAL_PATH=

# VPS only. Tamper-evident log of Remote Desktop logons, collected by the keeper every minute.
# Before turning it on, create the machine-only key once, elevated: py -3 -m desk.keeper rdp-log init
# See desk/keeper/RDPLOG.md.
RDPLOG_ENABLED=no
# Leave empty for %ProgramData%\WeekendDesk\rdp-log.jsonl and %ProgramData%\WeekendDesk\rdp-log.key.
RDPLOG_PATH=
RDPLOG_KEY_PATH=
