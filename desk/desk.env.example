# Set once. Use the same timezone and the same weekend hours on the VPS and on the home PC.

TIMEZONE=Europe/Berlin
OPEN_DAY=Friday
OPEN_TIME=22:00
CLOSE_DAY=Sunday
CLOSE_TIME=22:00

# Home PC only. The keeper ignores these.
VPS_HOST=
RDP_PORT=3389
RDP_TIMEOUT_SECONDS=5
GMAIL_ADDRESS=
PROVIDER_FROM=
PROVIDER_LINK_HOST=
# Leave SEAL_PATH empty to use %LOCALAPPDATA%\WeekendDesk\seal.json.
# That folder must not be OneDrive, Dropbox, Google Drive, or iCloud.
SEAL_PATH=
