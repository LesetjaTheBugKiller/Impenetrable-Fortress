# Copy to /etc/lichess-guard/app.env on the server and fill in real values there.
# Do not commit real tokens. The deploy script does not print this file.
# PORT and HOST are set by the deploy script from CONTAINER_PORT so the
# process listens on the published container port.

AUTH_SHARED=
LICHESS_TOKEN=

# Optional. Any other application setting can be added here.
# ENFORCE_LICHESS=true
# RECEIVER_DAILY_LOSS_CAP_PCT=3.0
# RECEIVER_DAILY_PROFIT_TARGET_PCT=6.0
# RECEIVER_MAX_LOSSES_PER_DAY=5
# RECEIVER_MAX_SPIKES_PER_DAY=2
# RECEIVER_COOLDOWN_AFTER_LOSS_MIN=5
# RECEIVER_REQUIRE_ALL_AT_BE=true
# RECEIVER_STATE_MAX_AGE_MS=5000
