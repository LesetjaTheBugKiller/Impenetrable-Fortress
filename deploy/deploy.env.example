# Copied to /etc/lichess-guard/deploy.env on the server when that file is missing.
# Re-run setup after changing DECISION_TIME so the systemd timer matches.
# The server's timezone should be the same as TIMEZONE. The timer uses the
# system timezone. The script checks the window in TIMEZONE.

DECISION_TIME=00:00
WINDOW_MINUTES=7
TIMEZONE=UTC
IMAGE_NAME=ghcr.io/lesetjaricco-png/server
CONTAINER_NAME=lichess-guard
HOST_PORT=8080
CONTAINER_PORT=8080
HEALTH_URL=
STARTUP_WAIT=30
